# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# CI workflow is held back: the current gh token lacks the `workflow` scope,
# so GitHub rejects pushes containing .github/workflows/*.
# To enable automatic deploys:  gh auth refresh -s workflow
# then delete these two lines and commit .github/workflows/deploy.yml
.github/workflows/
